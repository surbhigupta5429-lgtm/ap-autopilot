# Copy to .streamlit/secrets.toml (local) or paste into Streamlit Cloud → App settings → Secrets.
# Any ONE key is enough. With none, the app runs on local text-layer + OCR extraction.

GEMINI_API_KEY = "your-key"          # free tier at https://aistudio.google.com/apikey
# ANTHROPIC_API_KEY = "sk-ant-..."
# OPENAI_API_KEY = "sk-..."

# Optional model overrides
# GEMINI_MODEL = "gemini-2.5-flash"
# ANTHROPIC_MODEL = "claude-sonnet-5-5"
# OPENAI_MODEL = "gpt-4.1"
